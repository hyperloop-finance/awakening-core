(awakening_multichain) {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options DENY
        -Server
    }
    @arb_api path /arbitrum/api/v1/*
    handle @arb_api {
        uri strip_prefix /arbitrum
        request_body {
            max_size 1MB
        }
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8083
    }
    @rh_api path /robinhood/api/v1/*
    handle @rh_api {
        uri strip_prefix /robinhood
        request_body {
            max_size 1MB
        }
        header Cache-Control "no-store"
        reverse_proxy 127.0.0.1:8084
    }
    @private path /actuator /actuator/* /api /api/* /arbitrum/api /arbitrum/api/* /robinhood/api /robinhood/api/* /robinhood/actuator /robinhood/actuator/* /arbitrum/actuator /arbitrum/actuator/*
    handle @private {
        respond "Not found" 404
    }
    @rh path /robinhood /robinhood/*
    handle @rh {
        reverse_proxy 127.0.0.1:3001
    }
    handle {
        reverse_proxy 127.0.0.1:3000
    }
}
app.hyperloop-fi.xyz {
    import awakening_multichain
}
http://127.0.0.1:8088 {
    bind 127.0.0.1
    import awakening_multichain
}
