#!/bin/bash
set -euo pipefail
umask 077
backup_dir=/var/backups/awakening
install -d -m 700 "$backup_dir"
backup_file="$backup_dir/awakening_bsc-$(date -u +%Y%m%dT%H%M%SZ).dump"
runuser -u postgres -- pg_dump --format=custom --no-owner --no-acl awakening_bsc > "$backup_file.partial"
pg_restore --list "$backup_file.partial" >/dev/null
mv "$backup_file.partial" "$backup_file"
# Keep seven days of completed backups only; never touch unrelated files.
find /var/backups/awakening -maxdepth 1 -type f -name 'awakening_bsc-*.dump' -mtime +7 -delete
echo "Database backup completed: $backup_file"
