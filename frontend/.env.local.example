# Default is mock. Set to api only when the local backend is running.
NEXT_PUBLIC_DATA_PROFILE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Wallet connection only. Protocol transactions stay disabled until chain integration is verified.
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet.bnbchain.org
# Optional public Reown project ID for WalletConnect QR/mobile connections.
# Without it, only installed browser wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
