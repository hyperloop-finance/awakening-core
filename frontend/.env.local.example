# Local BNB Testnet backend. Use mock only for the separate offline preview.
NEXT_PUBLIC_DATA_PROFILE=api
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8082

# Transactions require the backend's verified deployment and explicit activation.
NEXT_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet.bnbchain.org
# Optional public Reown project ID for WalletConnect QR/mobile connections.
# Without it, only installed browser wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
