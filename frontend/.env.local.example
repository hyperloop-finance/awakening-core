# Default is mock. Set to api only when the local backend is running.
NEXT_PUBLIC_DATA_PROFILE=mock
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional EVM connectivity entry points. No deployed addresses are supplied by this project.
NEXT_PUBLIC_ANVIL_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_SEPOLIA_RPC_URL=
